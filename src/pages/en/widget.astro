---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/boater-check-en/" title="Do I need a boater card?" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free boater card check on your website" description="Put the free boater card check on your website: one iframe, every state and DC, an answer from birth date, boat and engine, with the official source. No sign-up, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the boater card check</h1>
    <p class="mt-3 text-lg text-navy-700">For a marina, a boat club, a rental business or a lake association: visitors pick their state, enter a birth date and a boat, and see whether they need a boater education card, with the official page it comes from.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the check visible and use it as it is, without warranty. When a state changes its rule, the embedded check updates itself.</p>
    <p>Nothing your visitors enter reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/boater-check-en/" title="Do I need a boater card?" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
